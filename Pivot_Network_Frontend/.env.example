# 环境变量示例。复制为 .env.local（默认 mock 模式）或 .env.demo（真实后端模式）。
# mock 模式（默认）：不填写任何变量，前端使用内置演示数据，无需后端即可完整浏览。
# 真实后端模式：VITE_USE_MOCK=false，并启动本机后端（见 Pivot_Network_Backend/Plantform_Backend/docs/LOCAL_DEMO.md）。

VITE_USE_MOCK=true
VITE_API_BASE_URL=http://127.0.0.1:8000

# 真实后端模式下自动登录的演示账号（后端种子数据，密码 demo1234）
VITE_DEMO_EMAIL=demo@pivot.local
VITE_DEMO_PASSWORD=demo1234
